# IO-106 AWS Network Architecture -- per-student variables.
# Copy to terraform.tfvars and set your assigned student id.

student_id = "s01"
region     = "us-east-1"

# scenario controls which lab state to deploy. Leave as "healthy" for Lab 0;
# your instructor / lab guide tells you when to switch to lab1..lab4.
scenario = "healthy"

